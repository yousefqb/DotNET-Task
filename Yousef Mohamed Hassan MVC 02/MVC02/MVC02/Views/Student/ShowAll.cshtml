@using MVC02.Models.Classes
@model List<Student>

<h1>studentInfo</h1>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Age</th>
            <th>DepId</th>
        </tr>
    </thead>
    <tbody>
        @foreach(Student item in Model)
        {
            <tr>
                <td>@item?.Id</td>
                <td>@item?.Name</td>
                <td>@item?.Age</td>
                <td>@item?.DepartmentId</td>
            </tr>
        }
    </tbody>
</table>