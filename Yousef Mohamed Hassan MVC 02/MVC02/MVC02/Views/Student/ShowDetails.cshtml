@using MVC02.Models.Classes
@model Student

<h1>studentInfo</h1>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Age</th>
            <th>DepId</th>
        </tr>
    </thead>
    <tbody>
            <tr>
                <td>@Model?.Id</td>
                <td>@Model?.Name</td>
                <td>@Model?.Age</td>
                <td>@Model?.DepartmentId</td>
            </tr>
    </tbody>
</table>