@model Student

<h1>Department Details</h1>

<table class="table table-bordered table-hover ">
    <thead>
        <tr>
            <th>Student Id</th>
            <th>Student name</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Model.Id</td>
            <td>@Model.Name</td>
        </tr>
    </tbody>
</table>