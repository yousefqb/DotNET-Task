@model Student

<h1>Confirm Delete</h1>

<h2>Are you sure you want to delete it</h2>

<h3>@Model.Id</h3>
<h3>@Model.Name</h3>
<h3>@Model.Salary</h3>
<form asp-action="ConfirmDelete" asp-route-id="@Model.Id">
    <input asp-for="Id" />

    <input type="submit" value="Delete" class="btn btn-danger" />
</form>
<a asp-action="Index">Back To List</a>