@model Student

<form method="post" action="/Student/SaveAdd">

    <label>Name</label>
    <input type="text" name="Name" value="@Model?.Name" class="form form-control" />

    <label>DepartmentId</label>
    <input type="text" name="DepartmentId" value="@Model?.DepartmentId" class="form form-control" />
        
    <input type="submit" value="Create" class="btn btn-success mt-3 mb-3" />
</form>
<a href="/Student/index"> Back to List</a>